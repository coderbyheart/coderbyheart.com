{
  "name": "@coderbyheart/coderbyheart.com",
  "version": "0.0.0-development",
  "description": "Source code for coderbyheart.com",
  "type": "module",
  "scripts": {
    "start": "vike dev",
    "prepare": "husky && cp ./node_modules/the-new-css-reset/css/reset.css public",
    "postinstall": "check-node-version --package",
    "lint": "eslint --ext .js,.ts,.tsx src",
    "build": "vike build"
  },
  "keywords": [
    "Markus Tacker",
    "coderbyheart",
    "homepage",
    "profile",
    "Vike",
    "React",
    "TypeScript",
    "Netlify",
    "GitHub Actions"
  ],
  "author": "Markus Tacker <m@coderbyheart.com>",
  "license": "UNLICENSED",
  "homepage": "https://coderbyheart.com",
  "bugs": {
    "url": "https://github.com/coderbyheart/coderbyheart.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coderbyheart/coderbyheart.com.git"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.817.0",
    "@bifravst/eslint-config-typescript": "6.1.22",
    "@bifravst/from-env": "3.0.2",
    "@bifravst/prettier-config": "1.1.8",
    "@bifravst/run": "1.2.0",
    "@commitlint/config-conventional": "19.8.1",
    "@types/lodash-es": "4.17.12",
    "bottleneck": "2.19.5",
    "check-node-version": "4.2.1",
    "commitlint": "19.8.1",
    "contentful": "11.5.23",
    "husky": "9.1.7",
    "lint-staged": "16.0.0",
    "mdast": "3.0.0",
    "prettier": "3.5.3",
    "rehype-format": "5.0.1",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-extract-frontmatter": "3.2.0",
    "remark-frontmatter": "5.0.0",
    "remark-rehype": "11.1.2",
    "unist-util-visit": "5.0.0",
    "vike": "0.4.230",
    "vike-solid": "0.7.10",
    "yaml": "2.8.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml,js,css}": [
      "prettier --write"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "@solid-primitives/intersection-observer": "2.2.1",
    "date-fns": "4.1.0",
    "lodash-es": "4.17.21",
    "solid-js": "1.9.7",
    "the-new-css-reset": "1.11.3"
  }
}
